{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/session-start.js",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/validate-ticket-format.js",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/block-dangerous-commands.js",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/detect-secrets.js",
        "timeout": 5
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/validate-subagent-ticket.js",
        "timeout": 5
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/log-subagent-stop.js",
        "timeout": 5
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/preserve-context.js",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./.github/hooks/scripts/session-stop-summary.js",
        "timeout": 5
      }
    ]
  }
}
